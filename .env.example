# ARGUS and Co. Investigation Agency Environment Configuration
PORT=5001
FRONTEND_PORT=5173
NODE_ENV=production

# OpenRouter AI Configuration
# Enter your OpenRouter API Key below
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME="ARGUS and Co. Investigation Agency"

# All Free Unlimited Quota Models on OpenRouter
OPENROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_FREE_MODELS=openrouter/free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free,liquid/lfm-2.5-2.6b:free,cohere/north-mini-code:free,thinkingmachines/inkling:free,recursive/flint-v1.0:free,dots-studio/dots-3-note-preview:free

# Agent Preferred Free Models
MODEL_ARGUS=openrouter/free
MODEL_APEX=google/gemma-4-31b-it:free
MODEL_LUTKIN=google/gemma-4-26b-a4b-it:free
MODEL_VANGUARD=nvidia/nemotron-3.5-lightning:free
MODEL_CORTEX=cohere/north-mini-code:free

# Bureau Database Vault
DATABASE_PATH=./data/argus.sqlite
UPLOAD_DIR=./uploads
